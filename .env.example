# ---------------------------------------------------------------------------
# Unified NVIDIA API — server configuration
#
# Every variable here is read SERVER-SIDE ONLY. None of them are prefixed with
# NEXT_PUBLIC_, so Next.js will never inline them into the client bundle and no
# API key can reach the browser.
# ---------------------------------------------------------------------------

# REQUIRED — your NVIDIA NIM API keys.
#
# Preferred form: one comma-separated list. Every key in the list joins the
# rotation pool, so add as many as you have to raise your effective rate limit.
NVIDIA_API_KEYS="nvapi-xxxxxxxxxxxxxxxx,nvapi-yyyyyyyyyyyyyyyy,nvapi-zzzzzzzzzzzzzzzz"

# Alternative indexed form (also supported; scanned from _1 to _64).
# Use either this or NVIDIA_API_KEYS — if both are set, all keys are pooled and
# duplicates are collapsed.
# NVIDIA_API_KEY_1="nvapi-xxxxxxxxxxxxxxxx"
# NVIDIA_API_KEY_2="nvapi-yyyyyyyyyyyyyyyy"

# Single-key convenience form.
# NVIDIA_API_KEY="nvapi-xxxxxxxxxxxxxxxx"

# OPTIONAL — upstream base URL. Defaults to NVIDIA's hosted NIM endpoint.
# Accepts either the /v1 root or a full /v1/chat/completions URL; both are
# normalized to the root internally.
# NVIDIA_API_URL="https://integrate.api.nvidia.com/v1"
